{
  "architecture": "qwen_spatial",
  "task": "det",
  "model_path": "${VALEN_MODEL_PATH}",
  "data": "${VALEN_DATA_ROOT}/det/processed/train.jsonl",
  "data_root": "${VALEN_DATA_ROOT}/det",
  "validation_data": "${VALEN_DATA_ROOT}/eval/det/processed/dev.jsonl",
  "validation_data_root": "${VALEN_DATA_ROOT}/eval/det",
  "data_seal": "${VALEN_DATA_ROOT}/det/manifests/ready.json",
  "coco_protocol": "none",
  "output": "${VALEN_RUN_DIR}/warmup",
  "stage": "warmup",
  "finetuning_type": "lora",
  "dtype": "bf16",
  "attn_implementation": "sdpa",
  "gradient_checkpointing": false,
  "spatial_width": 256,
  "spatial_layers": 2,
  "spatial_heads": 8,
  "spatial_queries": 100,
  "coordinate_bins": 512,
  "max_pixels": 262144,
  "max_length": 4096,
  "gradient_accumulation": 2,
  "required_world_size": 16,
  "epochs": 1,
  "save_every": 125,
  "head_lr": 0.0002,
  "seed": 42
}
