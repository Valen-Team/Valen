{
  "architecture": "qwen_spatial",
  "task": "det",
  "model_path": "${VALEN_MODEL_PATH}",
  "data": "${VALEN_DATA_ROOT}/det/processed/reasonseg_train.jsonl",
  "data_root": "${VALEN_DATA_ROOT}/det",
  "validation_data": "${VALEN_DATA_ROOT}/eval/det/reasonseg/processed/reasonseg_val.jsonl",
  "validation_data_root": "${VALEN_DATA_ROOT}/eval/det/reasonseg",
  "output": "${VALEN_RUN_DIR}/${VALEN_STAGE}",
  "stage": "${VALEN_STAGE}",
  "finetuning_type": "lora",
  "dtype": "bf16",
  "attn_implementation": "sdpa",
  "gradient_checkpointing": true,
  "spatial_width": 256,
  "spatial_layers": 2,
  "spatial_heads": 8,
  "spatial_queries": 100,
  "coordinate_bins": 512,
  "max_pixels": 262144,
  "max_length": 4096,
  "gradient_accumulation": 2,
  "required_world_size": 16,
  "epochs": 1,
  "save_every": 25,
  "head_lr": 0.0001,
  "lora_lr": 5e-05,
  "merger_lr": 1e-05,
  "lora_rank": 32,
  "lora_alpha": 64,
  "seed": 42
}
