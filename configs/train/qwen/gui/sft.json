{
  "architecture": "qwen_spatial",
  "task": "gui",
  "model_path": "${VALEN_MODEL_PATH}",
  "data": "${VALEN_DATA_ROOT}/gui/processed/train.jsonl",
  "data_root": "${VALEN_DATA_ROOT}/gui",
  "validation_data": "${VALEN_DATA_ROOT}/eval/gui/processed/gui_dev.jsonl",
  "validation_data_root": "${VALEN_DATA_ROOT}/eval/gui",
  "output": "${VALEN_RUN_DIR}/warmup",
  "stage": "warmup",
  "finetuning_type": "lora",
  "dtype": "bf16",
  "attn_implementation": "sdpa",
  "gradient_checkpointing": false,
  "spatial_width": 256,
  "spatial_layers": 2,
  "spatial_heads": 8,
  "spatial_queries": 1,
  "coordinate_bins": 512,
  "max_pixels": 1048576,
  "max_length": 8192,
  "gradient_accumulation": 4,
  "required_world_size": 8,
  "epochs": 1,
  "save_every": 125,
  "head_lr": 0.0002,
  "seed": 42
}
