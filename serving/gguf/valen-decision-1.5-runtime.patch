+// Grounding head of a bbox question: the readout scores the tokens of the image (softmax over the tokens),
+// and each token regresses the distances from its cell centre to the four edges of the box.
+// hidden is [hidden, 1 + token], the readout then the tokens of the image; centres is [4, token] with
+// x, y, x, y of the cell centres; cell is -1/cols, -1/rows, 1/cols, 1/rows.
+// Returns [1, 5]: the box x1, y1, x2, y2 of the most probable token, and the probability of the tokens
+// whose centre is in this box (its own token always is).
+inline ggml_tensor * valen_grounding_graph(
+        ggml_context * ctx, ggml_tensor * hidden, ggml_tensor * centres, ggml_tensor * cell,
+        const std::function<ggml_tensor *(const std::string &)> & weight) {
+    const valen_layers l{ctx, weight};
+    const int64_t n = centres->ne[1];
+    auto * d = l.norm(ggml_view_1d(ctx, hidden, hidden->ne[0], 0), "grounding.decision_norm");
+    auto * t = l.norm(ggml_view_2d(ctx, hidden, hidden->ne[0], n, hidden->nb[1], hidden->nb[1]), "grounding.token_norm");
+    auto * k = l.linear(t, "grounding.key");
+    auto * logits = ggml_mul_mat(ctx, k, l.mlp(d, "grounding.query"));
+    auto * probs = ggml_soft_max(ctx, ggml_scale(ctx, logits, 1.0f / sqrtf(float(k->ne[0]))));
+    auto * distances = ggml_mul(ctx, k, ggml_sigmoid(ctx, l.linear(d, "grounding.gate")));
+    distances = l.linear(ggml_gelu_erf(ctx, l.linear(l.norm(distances, "grounding.regress.0"), "grounding.regress.1")), "grounding.regress.3");
+    distances = ggml_scale_bias(ctx, ggml_softplus(ctx, distances), 1.0f, 0.5f);
+    auto * boxes = ggml_clamp(ctx, ggml_add(ctx, centres, ggml_mul(ctx, distances, cell)), 0.0f, 1.0f);
+    auto * box = ggml_get_rows(ctx, boxes, ggml_argmax(ctx, probs));
+    // a token is outside if its centre is past an edge of the box
+    auto * outside = ggml_step(ctx, ggml_sum_rows(ctx, ggml_step(ctx, ggml_mul(ctx, ggml_sub(ctx, centres, box), cell))));
+    auto * inside = ggml_reshape_2d(ctx, ggml_scale_bias(ctx, outside, -1.0f, 1.0f), n, 1);
+    return ggml_concat(ctx, ggml_reshape_2d(ctx, box, 1, 4), ggml_mul_mat(ctx, inside, probs), 1);
+}
